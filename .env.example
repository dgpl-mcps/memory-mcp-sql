# Memory Configuration - Enhanced

# Tool prefix (optional, default: memory)
TOOL_PREFIX=memory

# Short-term memory
MAX_SHORT_TERM_CHATS=10
SHORT_TERM_THRESHOLD=20

# Long-term memory
LONG_TERM_THRESHOLD=75
MAX_LONG_TERM_MEMORIES=1000

# Auto-summarization
AUTO_SUMMARIZE_AFTER_CHATS=20
INCREMENTAL_SUMMARIZE=true

# Summary settings
SUMMARY_MIN_LENGTH=50
SUMMARY_MAX_LENGTH=500

# Priority/importance scoring
ENABLE_PRIORITY_SCORING=true
PRIORITY_DECAY_DAYS=30

# Cross-session linking
ENABLE_SESSION_LINKING=true
CROSS_SESSION_THRESHOLD=60

# Search Configuration (NEW)
DEFAULT_SEARCH_LIMIT=10
DEFAULT_SEARCH_OFFSET=0
DEFAULT_CONFIDENCE_THRESHOLD=20

# Auto-cleanup
ENABLE_AUTO_CLEANUP=true
CLEANUP_AFTER_DAYS=90

# Context window
MAX_CONTEXT_TOKENS=8000
CONTEXT_OVERLAP=3
# =====================================================
# Database location (new in v1.x)
# =====================================================
# Default: ~/.memory/memory_db (auto-created on first run)
# Override by setting MEMORY_DB_PATH.
# Examples:
#   MEMORY_DB_PATH=/var/lib/memory/memory.db
#   MEMORY_DB_PATH=./test.db
#MEMORY_DB_PATH=

# =====================================================
# Vector search / embedding (new in v1.x)
# =====================================================
# By default we use a local embedder (zero config, fully offline).
# Optionally point to a remote OpenAI-compatible embedding endpoint
# (Ollama, vLLM, OpenAI, etc.). Expected request: POST { input: text }
# Expected response: { embedding: number[384] }.
# EMBEDDING_URL=http://localhost:11434/v1/embeddings

# Tool defer-loading (default: true to keep initial handshake small)
# Set to 'false' to expose all tools immediately
#ENABLE_DEFER_LOADING=true
