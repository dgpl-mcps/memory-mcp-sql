# Memory Configuration

# Short-term memory: max chats to keep (default: 10)
MAX_SHORT_TERM_CHATS=10

# Short-term search threshold (default: 20%)
SHORT_TERM_THRESHOLD=20

# Long-term search threshold (default: 75%)
LONG_TERM_THRESHOLD=75

# Auto-summarize after N chats (default: 20)
AUTO_SUMMARIZE_AFTER_CHATS=20

# Summary min/max length (default: 50-500)
SUMMARY_MIN_LENGTH=50
SUMMARY_MAX_LENGTH=500